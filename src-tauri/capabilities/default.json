{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, quick chat, and desktop pet windows",
  "windows": ["main", "quick-chat", "pet"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
