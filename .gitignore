# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.artifacts/

# Local memory benchmark output may contain machine-specific measurements.
benchmarks/memory/reports/*
!benchmarks/memory/reports/.gitkeep

# Tauri Updater private keys and locally generated release manifests
*.key
*.key.pub
latest.json

# Local development and learning documents. Keep the entire tree local-only.
/md/

# Diagnostic and preview artifacts produced while debugging UI work.
# They are regenerable and reference sandbox-only paths.
mermaid-diagnose.js
mermaid-repro/
theme-preview/
usage-preview/
commit-paths.txt

# Scratch space for render probes and other intermediate artifacts.
# Cleaned up manually, never committed.
/temp/

# Desktop agent session settings
.claude/
__pycache__/
*.py[cod]

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
